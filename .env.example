# Wasfa AI environment variables. Copy this file and fill in real values; never commit the copy.
#
#   Local development : copy to `.env` in the repo root (read by `pnpm dev`, `pnpm db:migrate`).
#   Production        : copy to `/opt/wasfa/.env.prod` on the server, `chmod 600`, and pass it with
#                       `docker compose --env-file .env.prod -f compose.prod.yml ...`.
#
# Generate secrets with:   openssl rand -hex 24      (passwords: hex only, they are embedded in URLs)
#                          openssl rand -base64 32    (ENCRYPTION_KEY)
# Every value below is a placeholder. Values written as REPLACE_ME must be replaced.

# ------------------------------------------------------------------------------------------------
# Shared by api, worker and tools
# ------------------------------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection string (api, worker later, migrations, seed).
# Local: matches infra/docker/compose.dev.yml. Production: assembled by compose from POSTGRES_*.
DATABASE_URL=postgres://wasfa:wasfa_dev_password@127.0.0.1:5432/wasfa

# Redis connection string (rate limits, queues, worker heartbeat).
# Local: no password. Production: assembled by compose from REDIS_PASSWORD.
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------------------------
# API (apps/api)
# ------------------------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=4000
# Exact origins (comma separated) allowed to call the API with credentials. No wildcards.
WEB_ORIGIN=http://localhost:3000
# AES-256-GCM key for secrets stored in the database (admin-entered API keys). 32 bytes, base64.
ENCRYPTION_KEY=REPLACE_ME
# IPs/CIDRs of the reverse proxy allowed to set CF-Connecting-IP. Empty = trust nobody (local dev).
# Production compose sets this to Caddy's fixed address.
TRUST_PROXY=
# Requests per minute per IP across the API (stricter per-route limits are set in code).
RATE_LIMIT_MAX=120

# WhatsApp number users send their phone-verification code to: the dedicated business number linked to
# the wa-bridge (digits with country code, a leading + is fine). Empty = phone verification is
# unavailable and the UI hides it.
WHATSAPP_NUMBER=

# --- Authentication (Better Auth, Task 1.3) ---
# Signs session cookies and verification tokens. At least 32 characters: `openssl rand -base64 48`.
# Rotating it signs every user out (nothing else breaks), so it needs no safe-keeping beyond .env.prod.
BETTER_AUTH_SECRET=REPLACE_ME
# Public origin of this API. Links in verification emails and OAuth callbacks are built from it.
# Production: https://api.wasfa.online (must be https).
API_PUBLIC_URL=http://localhost:4000
# Domain of the session cookie, so wasfa.online and api.wasfa.online share one login.
# Production: .wasfa.online (required). Leave empty locally: the cookie is then host-only.
AUTH_COOKIE_DOMAIN=
# Argon2id memory cost in KiB (OWASP minimum 19456). Raise it if the server has headroom.
ARGON2_MEMORY_KIB=19456
# Cloudflare Turnstile SECRET key (the site key is public and belongs to the web app, Task 1.9).
# Required in production. Empty = Turnstile checks are skipped (local development only).
# Cloudflare's always-pass test secret for development: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# Google OAuth (web client). Redirect URI: https://api.wasfa.online/auth/callback/google
# A provider with empty keys can never be enabled; both values must be set together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook is "coming soon": leave empty until the owner creates the app. Enabling it later is these
# two keys plus the `auth` setting in the admin panel, with no code change.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ------------------------------------------------------------------------------------------------
# Worker (apps/worker)
# ------------------------------------------------------------------------------------------------
# Jobs processed in parallel on the `system` and `notifications` (email) queues.
WORKER_CONCURRENCY_SYSTEM=1
WORKER_CONCURRENCY_NOTIFICATIONS=1
# The worker needs the same ENCRYPTION_KEY as the api: email links travel encrypted in the queue.
# It also needs DATABASE_URL (above): the scheduled jobs anonymize deleted and never-verified accounts
# and purge expired sessions. In production it connects as the same restricted role as the api.

# --- Email (Task 1.4) ---
# Brevo SMTP relay (free plan: 300 mails a day). Brevo > SMTP & API > SMTP: the login is the account
# address Brevo shows, the password is an SMTP key (not the API key). Production requires all three.
# Left empty locally, the worker CAPTURES mail in Redis instead of sending it (never in production):
#   docker exec <redis> redis-cli lrange mail:capture 0 0     # newest message, with the link
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address; the domain must be authenticated in Brevo (SPF + DKIM) and have DMARC.
MAIL_FROM='"وصفة AI" <no-reply@wasfa.online>'
# Daily send cap, a margin under the provider's. Non-critical mail waits for the next UTC day.
MAIL_DAILY_CAP=280
# How long shutdown waits for active jobs before forcing (milliseconds).
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------------------------
# Web (apps/web)
# NEXT_PUBLIC_* are inlined at BUILD time: for Docker they are build args (compose.build.yml).
# A build whose NEXT_PUBLIC_ENV is not `production` is noindex and its robots.txt disallows all.
# ------------------------------------------------------------------------------------------------
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Extra Content-Security-Policy sources, read at RUNTIME (space or comma separated http(s) hosts).
# Cloudflare Turnstile needs:  CSP_SCRIPT_SRC_EXTRA=https://challenges.cloudflare.com
#                              CSP_FRAME_SRC_EXTRA=https://challenges.cloudflare.com
CSP_SCRIPT_SRC_EXTRA=
CSP_CONNECT_SRC_EXTRA=
CSP_FRAME_SRC_EXTRA=
CSP_IMG_SRC_EXTRA=

# ------------------------------------------------------------------------------------------------
# Production stack only (infra/docker/compose.prod.yml, read from .env.prod)
# ------------------------------------------------------------------------------------------------
# GitHub account/organisation that owns the images, lowercase: ghcr.io/<GHCR_OWNER>/wasfa-api
GHCR_OWNER=ahmed7v3
# Image tag to run; the deploy workflow sets this to the git SHA, `latest` is the fallback.
IMAGE_TAG=latest

SITE_DOMAIN=wasfa.online
API_DOMAIN=api.wasfa.online

POSTGRES_USER=wasfa
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=wasfa

REDIS_PASSWORD=REPLACE_ME

# Password of the restricted database role `wasfa_api` that the api and the WhatsApp bridge connect as
# (it cannot UPDATE or DELETE audit_logs). The migrate step creates the role and sets this password.
# Hex only, because it is placed inside a URL:  openssl rand -hex 24
API_DB_PASSWORD=REPLACE_ME

# Local run of the production stack only: use Caddy's own CA instead of Cloudflare certificates.
# CADDY_TLS_FILE=./caddy/tls.local.caddy

# ------------------------------------------------------------------------------------------------
# Backups (infra/scripts/backup.sh, Task 0.10)
# ------------------------------------------------------------------------------------------------
# Cloudflare R2 (S3 compatible). Create an API token scoped to the backups bucket only.
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET=wasfa-backups
# age PUBLIC key (starts with age1...). The matching private key is kept offline by the owner.
BACKUP_AGE_PUBLIC_KEY=REPLACE_ME
# Optional: only to point the backup at another S3-compatible store (e.g. a local test server).
# R2_ENDPOINT=
# R2_PROVIDER=Cloudflare
# Retention: newest N daily and weekly dumps are kept.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Optional dead-man's switch (healthchecks.io style URL): pinged after every successful backup, so a
# backup that never runs at all is noticed too. Leave empty to disable.
BACKUP_HEALTHCHECK_URL=
# Optional: failure alerts via Telegram bot. Leave empty to disable.
BACKUP_ALERT_TELEGRAM_BOT_TOKEN=
BACKUP_ALERT_TELEGRAM_CHAT_ID=
