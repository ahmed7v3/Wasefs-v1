{
  "name": "@wasfa/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI provider adapters, live model discovery, integer pricing and the fallback runner for Wasfa",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
