    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@wasfa/config": "workspace:*",
    "eslint": "^10.12.0",
    "msw": "^2.15.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
