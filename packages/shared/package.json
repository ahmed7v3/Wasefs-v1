{
  "name": "@wasfa/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared zod schemas, error codes, money/id utils and i18n for Wasfa",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./ids": {
      "types": "./dist/ids.d.ts",
      "import": "./dist/ids.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "import": "./dist/money.js"
    },
    "./queues": {
      "types": "./dist/queues.d.ts",
      "import": "./dist/queues.js"
    },
    "./redact": {
      "types": "./dist/redact.d.ts",
      "import": "./dist/redact.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@wasfa/config": "workspace:*",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
