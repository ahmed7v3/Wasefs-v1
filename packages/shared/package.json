    "./schemas/user": {
      "types": "./dist/schemas/user.d.ts",
      "import": "./dist/schemas/user.js",
      "default": "./dist/schemas/user.js"
    },
    "./schemas/org": {
      "types": "./dist/schemas/org.d.ts",
      "import": "./dist/schemas/org.js",
      "default": "./dist/schemas/org.js"
    },
    "./schemas/contact": {
      "types": "./dist/schemas/contact.d.ts",
      "import": "./dist/schemas/contact.js",
      "default": "./dist/schemas/contact.js"
    },
    "./schemas/onboarding": {
      "types": "./dist/schemas/onboarding.d.ts",
      "import": "./dist/schemas/onboarding.js",
      "default": "./dist/schemas/onboarding.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@wasfa/config": "workspace:*",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
