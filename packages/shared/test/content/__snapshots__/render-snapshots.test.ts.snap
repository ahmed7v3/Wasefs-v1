exports[`body_html snapshots > en-article-full > html 1`] = `
"<h2 id="understanding-headaches">Understanding headaches</h2>
<p>Headaches are among the most common reasons to see a doctor. Many people take <a href="/en/drugs/ibuprofen" title="Ibuprofen" class="entity-link" data-entity="drug">Ibuprofen</a> for relief, but the <strong>dose</strong> depends on age.</p>
<h2 id="symptoms">Symptoms</h2>
<ol>
<li>Throbbing pain on one side</li>
<li>Sensitivity to light</li>
<li>Nausea</li>
</ol>
<figure><picture><source type="image/avif" srcset="https://media.wasfa.online/media/aa11/640.avif 640w, https://media.wasfa.online/media/aa11/1280.avif 1280w" sizes="(min-width: 768px) 720px, 100vw"><source type="image/webp" srcset="https://media.wasfa.online/media/aa11/640.webp 640w, https://media.wasfa.online/media/aa11/1280.webp 1280w" sizes="(min-width: 768px) 720px, 100vw"><img src="https://media.wasfa.online/media/aa11/1200.jpg" width="1200" height="675" alt="A tablet" loading="lazy" decoding="async"></picture></figure>
<aside class="callout callout-tip" role="note"><p><strong>Tip</strong></p><p>Keep a headache diary to share with your doctor.</p></aside>
<blockquote>
<p>Always read the leaflet before taking any medicine.</p>
</blockquote>
<p>See <a href="https://pubmed.ncbi.nlm.nih.gov/12345/" rel="noopener noreferrer">a review</a> and <a href="https://example.com/post" rel="noopener noreferrer nofollow">a blog</a>.</p>
<aside class="content-cta" data-cta="analyze"><p>Have a prescription you want to understand?</p><p><a href="/register">Try the prescription reader free</a></p></aside>"
`;

