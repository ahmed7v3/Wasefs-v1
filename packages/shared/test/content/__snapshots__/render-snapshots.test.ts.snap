exports[`body_html snapshots > ar-page-mixed-direction > html 1`] = `
"<h2 id="jraat-alatfal">جرعات الأطفال</h2>
<p>يُعطى Paracetamol للأطفال بجرعة 10-15 mg/kg كل 6 ساعات، ولا تتجاوز 4 جرعات في اليوم (QID).</p>
<ol>
<li>افحص الوزن</li>
<li>احسب الجرعة: <code>weight × 15 mg</code></li>
<li>استخدم الأداة المرفقة</li>
</ol>
<figure><picture><img src="https://media.wasfa.online/media/bb22/800.jpg" width="800" height="400" alt="" loading="lazy" decoding="async"></picture></figure>"
`;

