exports[`body_html snapshots > ar-autolink-limits > html 1`] = `
"<p>يحتوي الدواء على <a href="/drugs/paracetamol" title="باراسيتامول" class="entity-link" data-entity="drug">باراسيتامول</a> وهو مسكن، ويُؤخذ مع الأكل. ويختلف باراسيتامول عن ايبوبروفين في آلية العمل.</p>
<h2 id="an-barasytamwl">عن باراسيتامول</h2>
<p>الأسيتامينوفين هو الاسم الآخر. بعد ذلك بكلمات كثيرة جدًا نذكر ايبوبروفين من جديد كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة كلمة ثم <a href="/drugs/ibuprofen" title="ايبوبروفين" class="entity-link" data-entity="drug">ايبوبروفين</a> وباراسيتامول مرة أخرى.</p>"
`;

