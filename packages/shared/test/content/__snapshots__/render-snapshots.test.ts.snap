exports[`body_html snapshots > ar-article-full > html 1`] = `
"<h2 id="kl-ma-thtaj-marfth-an-alsdaa">كل ما تحتاج معرفته عن الصداع</h2>
<p>الصداع من أكثر الأسباب شيوعًا لزيارة الطبيب. يستخدم كثيرون <a href="/drugs/paracetamol" title="باراسيتامول" class="entity-link" data-entity="drug">باراسيتامول</a> لتخفيف الألم، لكن <strong>الجرعة</strong> تختلف حسب العمر.</p>
<h2 id="alaarad">الأعراض</h2>
<ul>
<li>ألم نابض في جانب واحد</li>
<li>حساسية للضوء</li>
<li>غثيان</li>
</ul>
<figure><picture><source type="image/avif" srcset="https://media.wasfa.online/media/aa11/640.avif 640w, https://media.wasfa.online/media/aa11/1280.avif 1280w" sizes="(min-width: 768px) 720px, 100vw"><source type="image/webp" srcset="https://media.wasfa.online/media/aa11/640.webp 640w, https://media.wasfa.online/media/aa11/1280.webp 1280w" sizes="(min-width: 768px) 720px, 100vw"><img src="https://media.wasfa.online/media/aa11/1200.jpg" width="1200" height="675" alt="قرص دواء" loading="lazy" decoding="async"></picture><figcaption>الجرعة الصحيحة أهم من كثرة الدواء</figcaption></figure>
<aside class="callout callout-warning" role="note"><p><strong>تنبيه طبي</strong></p><p>لا تتجاوز الجرعة القصوى اليومية دون استشارة الطبيب.</p></aside>
<h3 id="mty-tzwr-altbyb">متى تزور الطبيب؟</h3>
<p>راجع الطبيب إذا استمر الصداع أكثر من ثلاثة أيام<sup><a href="#fn-1" id="fnref-1" data-footnote-ref aria-describedby="footnote-label">1</a></sup>. اقرأ أيضًا <a href="/guides/headache-guide">دليل الصداع</a> و<a href="https://www.who.int/news-room" rel="noopener noreferrer">منظمة الصحة العالمية</a>.</p>
<aside class="content-cta" data-cta="analyze"><p>هل لديك روشتة تحتاج إلى فهمها؟</p><p><a href="/register">جرّب تحليل روشتتك مجانًا</a></p></aside>
<section data-footnotes class="footnotes"><h2 id="footnote-label">المراجع والهوامش</h2>
<ol>
<li id="fn-1">
<p>مصدر: منظمة الصحة العالمية، 2024. <a href="#fnref-1" data-footnote-backref="" aria-label="العودة إلى المرجع 1" class="data-footnote-backref">↩</a></p>
</li>
</ol>
</section>"
`;

