{
  "name": "@wasfa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wasfa REST API (NestJS on Fastify)",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --watch-path=src --import @swc-node/register/esm-register src/main.ts",
    "start": "node dist/main.js",
    "admin:grant": "node dist/cli/admin-grant.js",
    "key:rotate": "node dist/cli/rotate-encryption-key.js",
    "admin:grant:dev": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/cli/admin-grant.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@node-rs/argon2": "^2.2.2",
    "@wasfa/ai": "workspace:*",
    "@wasfa/db": "workspace:*",
    "@wasfa/shared": "workspace:*",
    "better-auth": "1.7.7",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "5.12.5",
    "ioredis": "^5.11.1",
    "kysely": "0.29.6",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "proxy-addr": "^2.0.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@testcontainers/minio": "12.2.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/node": "^24.0.0",
    "@types/proxy-addr": "^2.0.3",
    "@wasfa/config": "workspace:*",
    "eslint": "^10.12.0",
    "msw": "^2.15.0",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
