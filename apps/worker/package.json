{
  "name": "@wasfa/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wasfa background worker (BullMQ consumers)",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --watch-path=src --import @swc-node/register/esm-register src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@wasfa/shared": "workspace:*",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@testcontainers/redis": "^12.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@wasfa/config": "workspace:*",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
