{
  "name": "@wasfa/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wasfa public site and app (Next.js)",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "test:prod-smoke": "playwright test --project=prod-smoke",
    "check:bundles": "node scripts/check-public-bundles.mjs"
  },
  "dependencies": {
    "@wasfa/shared": "workspace:*",
    "@wasfa/ui": "workspace:*",
    "heic2any": "0.0.4",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "pdfjs-dist": "6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@axe-core/playwright": "^4.14.0",
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/minio": "12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wasfa/config": "workspace:*",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ioredis": "^5.11.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.2.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ]
}
